generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

enum WorkshopStatus {
  DRAFT
  OPEN
  FULL
  CANCELLED
  COMPLETED
}

enum RegistrationStatus {
  ACTIVE
  CANCELLED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdWorkshops Workshop[] @relation("WorkshopCreatedBy")
  updatedWorkshops Workshop[] @relation("WorkshopUpdatedBy")

  registrationsCreated   Registration[] @relation("RegistrationCreatedBy")
  registrationsCancelled Registration[] @relation("RegistrationCancelledBy")
}

model Workshop {
  id          Int            @id @default(autoincrement())
  code        String         @unique
  title       String
  description String?
  instructor  String
  location    String
  dateTime    DateTime
  capacity    Int
  status      WorkshopStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById Int?
  updatedById Int?

  createdBy User? @relation("WorkshopCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("WorkshopUpdatedBy", fields: [updatedById], references: [id])

  registrations Registration[]

  @@index([dateTime])
  @@index([status])
}

model Registration {
  id Int @id @default(autoincrement())

  workshopId    Int
  attendeeName  String
  attendeeEmail String

  status RegistrationStatus @default(ACTIVE)

  registeredAt DateTime  @default(now())
  cancelledAt  DateTime?

  registeredById Int
  cancelledById  Int?

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Restrict)

  registeredBy User  @relation("RegistrationCreatedBy", fields: [registeredById], references: [id])
  cancelledBy  User? @relation("RegistrationCancelledBy", fields: [cancelledById], references: [id])

  @@index([workshopId])
  @@index([status])
  @@index([attendeeEmail])
}